# Empêche tout accès direct aux fichiers de ce dossier.
# Les documents ne doivent être servis que via modules/rapports/download.php,
# qui vérifie l'authentification avant de transmettre le fichier.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
